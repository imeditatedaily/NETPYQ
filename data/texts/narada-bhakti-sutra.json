{
 "id": "narada-bhakti-sutra",
 "title": "Nārada Bhakti Sūtra",
 "title_sa": "नारदभक्तिसूत्रम्",
 "subject": "yoga",
 "unit": 1,
 "topics": [
  "Narada Bhakti Sutra"
 ],
 "about": "84 sūtras on bhakti, ascribed to the sage Nārada: its nature, means, the eleven forms of attachment (āsakti) and the glory of the devotee. Editions differ in a few words (for example sūtras 30, 46, 62, 63 and 84); the reading here follows the commonly printed text.",
 "divisions": [
  "sūtra"
 ],
 "sources": [
  "ebharati-narada-bhakti-sutra"
 ],
 "lines": [
  {
   "ref": "1",
   "sa": "अथातो भक्तिं व्याख्यास्यामः ॥",
   "head": "भक्तेः स्वरूपम्"
  },
  {
   "ref": "2",
   "sa": "सा त्वस्मिन् परमप्रेमरूपा ॥"
  },
  {
   "ref": "3",
   "sa": "अमृतस्वरूपा च ॥"
  },
  {
   "ref": "4",
   "sa": "यल्लब्ध्वा पुमान् सिद्धो भवति, अमृतो भवति, तृप्तो भवति ॥"
  },
  {
   "ref": "5",
   "sa": "यत्प्राप्य न किञ्चिद्वाञ्छति, न शोचति, न द्वेष्टि, न रमते, नोत्साही भवति ॥"
  },
  {
   "ref": "6",
   "sa": "यज्ज्ञात्वा मत्तो भवति, स्तब्धो भवति, आत्मारामो भवति ॥"
  },
  {
   "ref": "7",
   "sa": "सा न कामयमाना निरोधरूपत्वात् ॥",
   "head": "प्रेम्णि अनन्यता"
  },
  {
   "ref": "8",
   "sa": "निरोधस्तु लोकवेदव्यापारन्यासः ॥"
  },
  {
   "ref": "9",
   "sa": "तस्मिन्ननन्यता तद्विरोधिषूदासीनता च ॥"
  },
  {
   "ref": "10",
   "sa": "अन्याश्रयाणां त्यागोऽनन्यता ॥"
  },
  {
   "ref": "11",
   "sa": "लोकवेदेषु तदनुकूलाचरणं तद्विरोधिषूदासीनता ॥"
  },
  {
   "ref": "12",
   "sa": "भवतु निश्चयदार्ढ्यादूर्ध्वं शास्त्ररक्षणम् ॥"
  },
  {
   "ref": "13",
   "sa": "अन्यथा पातित्यशङ्कया ॥"
  },
  {
   "ref": "14",
   "sa": "लोकोऽपि तावदेव, किन्तु भोजनादिव्यापारस्त्वाशरीरधारणावधि ॥"
  },
  {
   "ref": "15",
   "sa": "तल्लक्षणानि वाच्यन्ते नानामतभेदात् ॥",
   "head": "प्रेमरूपायाः भक्तेर्लक्षणानि, उदाहरणानि च"
  },
  {
   "ref": "16",
   "sa": "पूजादिष्वनुराग इति पाराशर्यः ॥"
  },
  {
   "ref": "17",
   "sa": "कथादिष्विति गर्गः ॥"
  },
  {
   "ref": "18",
   "sa": "आत्मरत्यविरोधेनेति शाण्डिल्यः ॥"
  },
  {
   "ref": "19",
   "sa": "नारदस्तु तदर्पिताखिलाचारता तद्विस्मरणे परमव्याकुलतेति ॥"
  },
  {
   "ref": "20",
   "sa": "अस्त्येवमेवम् ॥"
  },
  {
   "ref": "21",
   "sa": "यथा व्रजगोपिकानाम् ॥"
  },
  {
   "ref": "22",
   "sa": "तत्रापि न माहात्म्यज्ञानविस्मृत्यपवादः ॥"
  },
  {
   "ref": "23",
   "sa": "तद्विहीनं जाराणामिव ॥"
  },
  {
   "ref": "24",
   "sa": "नास्त्येव तस्मिँस्तत्सुखसुखित्वम् ॥"
  },
  {
   "ref": "25",
   "sa": "सा तु कर्मज्ञानयोगेभ्योऽप्यधिकतरा ॥",
   "head": "प्रेमरूपायाः भक्तेः फलरूपत्वम्"
  },
  {
   "ref": "26",
   "sa": "फलरूपत्वात् ॥"
  },
  {
   "ref": "27",
   "sa": "ईश्वरस्याप्यभिमानद्वेषित्वाद् दैन्यप्रियत्वाच्च ॥"
  },
  {
   "ref": "28",
   "sa": "तस्या ज्ञानमेव साधनमित्येके ॥"
  },
  {
   "ref": "29",
   "sa": "अन्योन्याश्रयत्वमित्यन्ये ॥"
  },
  {
   "ref": "30",
   "sa": "स्वयं फलरूपतेति ब्रह्मकुमाराः ॥"
  },
  {
   "ref": "31",
   "sa": "राजगृहभोजनादिषु तथैव दृष्टत्वात् ॥"
  },
  {
   "ref": "32",
   "sa": "न तेन राजपरितोषः क्षुच्छान्तिर्वा ॥"
  },
  {
   "ref": "33",
   "sa": "तस्मात् सैव ग्राह्या मुमुक्षुभिः ॥"
  },
  {
   "ref": "34",
   "sa": "तस्याः साधनानि गायन्त्याचार्याः ॥",
   "head": "भक्तेः साधनानि"
  },
  {
   "ref": "35",
   "sa": "तत्तु विषयत्यागात् सङ्गत्यागाच्च ॥"
  },
  {
   "ref": "36",
   "sa": "अव्यावृतभजनात् ॥"
  },
  {
   "ref": "37",
   "sa": "लोकेऽपि भगवद्गुणश्रवणकीर्तनात् ॥"
  },
  {
   "ref": "38",
   "sa": "मुख्यतस्तु महत्कृपयैव भगवत्कृपालेशाद्वा ॥"
  },
  {
   "ref": "39",
   "sa": "महत्सङ्गस्तु दुर्लभोऽगम्योऽमोघश्च ॥",
   "head": "सत्सङ्गस्य माहात्म्यम्"
  },
  {
   "ref": "40",
   "sa": "लभ्यतेऽपि तत्कृपयैव ॥"
  },
  {
   "ref": "41",
   "sa": "तस्मिँस्तज्जने भेदाभावात् ॥"
  },
  {
   "ref": "42",
   "sa": "तदेव साध्यतां तदेव साध्यताम् ॥"
  },
  {
   "ref": "43",
   "sa": "दुःसङ्गः सर्वथैव त्याज्यः ॥",
   "head": "दुःसङ्गस्य त्यागः"
  },
  {
   "ref": "44",
   "sa": "काम-क्रोध-मोह-स्मृतिभ्रंश-बुद्धिनाश-सर्वनाशकारणत्वात् ॥"
  },
  {
   "ref": "45",
   "sa": "तरङ्गायिता अपीमे सङ्गात् समुद्रायन्ति ॥"
  },
  {
   "ref": "46",
   "sa": "कस्तरति कस्तरति मायाम् ? यः सङ्गाँस्त्यजति, यो महानुभावं सेवते, निर्ममो भवति ॥",
   "head": "मायां कस्तरति"
  },
  {
   "ref": "47",
   "sa": "यो विविक्तस्थानं सेवते, यो लोकबन्धमुन्मूलयति, निस्त्रैगुण्यो भवति, यो योगक्षेमं त्यजति ॥"
  },
  {
   "ref": "48",
   "sa": "यः कर्मफलं त्यजति, कर्माणि संन्यस्यति, ततो निर्द्वन्द्वो भवति ॥"
  },
  {
   "ref": "49",
   "sa": "यो वेदानपि संन्यस्यति, केवलमविच्छिन्नानुरागं लभते ॥"
  },
  {
   "ref": "50",
   "sa": "स तरति, स तरति, स लोकाँस्तारयति ॥"
  },
  {
   "ref": "51",
   "sa": "अनिर्वचनीयं प्रेमस्वरूपम् ॥",
   "head": "पराभक्तिर्गौणीभक्तिश्च"
  },
  {
   "ref": "52",
   "sa": "मूकास्वादनवत् ॥"
  },
  {
   "ref": "53",
   "sa": "प्रकाशते क्वापि पात्रे ॥"
  },
  {
   "ref": "54",
   "sa": "गुणरहितं कामनारहितं प्रतिक्षणवर्धमानमविच्छिन्नं सूक्ष्मतरमनुभवरूपम् ॥"
  },
  {
   "ref": "55",
   "sa": "तत्प्राप्य तदेवावलोकयति, तदेव शृणोति, तदेव भाषयति, तदेव चिन्तयति ॥"
  },
  {
   "ref": "56",
   "sa": "गौणी त्रिधा गुणभेदादार्तादिभेदाद्वा ॥"
  },
  {
   "ref": "57",
   "sa": "उत्तरस्मादुत्तरस्मात् पूर्वपूर्वा श्रेयाय भवति ॥"
  },
  {
   "ref": "58",
   "sa": "अन्यस्मात् सौलभ्यं भक्तौ ॥",
   "head": "भक्तेः सौलभ्यं महत्त्वं च"
  },
  {
   "ref": "59",
   "sa": "प्रमाणान्तरस्यानपेक्षत्वात् स्वयं प्रमाणत्वात् ॥"
  },
  {
   "ref": "60",
   "sa": "शान्तिरूपात् परमानन्दरूपाच्च ॥"
  },
  {
   "ref": "61",
   "sa": "लोकहानौ चिन्ता न कार्या, निवेदितात्मलोकवेदत्वात् ॥",
   "head": "भक्तेः साधनान्यन्तरायाश्च"
  },
  {
   "ref": "62",
   "sa": "न तत्सिद्धौ लोकव्यवहारो हेयः, किन्तु फलत्यागस्तत्साधनं च कार्यमेव ॥"
  },
  {
   "ref": "63",
   "sa": "स्त्री-धन-नास्तिक-वैरिचरित्रं न श्रवणीयम् ॥"
  },
  {
   "ref": "64",
   "sa": "अभिमान-दम्भादिकं त्याज्यम् ॥"
  },
  {
   "ref": "65",
   "sa": "तदर्पिताखिलाचारः सन् कामक्रोधाभिमानादिकं तस्मिन्नेव करणीयम् ॥"
  },
  {
   "ref": "66",
   "sa": "त्रिरूपभङ्गपूर्वकं नित्यदास्य-नित्यकान्ताभजनात्मकं वा प्रेमैव कार्यं प्रेमैव कार्यम् ॥",
   "head": "प्रेमिभक्तानां महिमा"
  },
  {
   "ref": "67",
   "sa": "भक्ता एकान्तिनो मुख्याः ॥"
  },
  {
   "ref": "68",
   "sa": "कण्ठावरोधरोमाञ्चाश्रुभिः परस्परं लपमानाः पावयन्ति कुलानि पृथिवीं च ॥"
  },
  {
   "ref": "69",
   "sa": "तीर्थीकुर्वन्ति तीर्थानि, सुकर्मीकुर्वन्ति कर्माणि, सच्छास्त्रीकुर्वन्ति शास्त्राणि ॥"
  },
  {
   "ref": "70",
   "sa": "तन्मयाः ॥"
  },
  {
   "ref": "71",
   "sa": "मोदन्ते पितरो नृत्यन्ति देवताः सनाथा चेयं भूमिर्भवति ॥"
  },
  {
   "ref": "72",
   "sa": "नास्ति तेषु जाति-विद्या-रूप-कुल-धन-क्रियादिभेदः ॥"
  },
  {
   "ref": "73",
   "sa": "यतस्तदीयाः ॥"
  },
  {
   "ref": "74",
   "sa": "वादो नावलम्ब्यः ॥",
   "head": "वाद-विवादरूपा विघ्नाः"
  },
  {
   "ref": "75",
   "sa": "बाहुल्यावकाशत्वादनियतत्वाच्च ॥"
  },
  {
   "ref": "76",
   "sa": "भक्तिशास्त्राणि मननीयानि, तदुद्बोधककर्माण्यपि करणीयानि ॥",
   "head": "भक्तेः प्रधानाः सहायकाः"
  },
  {
   "ref": "77",
   "sa": "सुखदुःखेच्छालाभादित्यक्ते काले प्रतीक्ष्यमाणे क्षणार्धमपि व्यर्थं न नेयम् ॥"
  },
  {
   "ref": "78",
   "sa": "अहिंसा-सत्य-शौच-दयास्तिक्यादिचारित्र्याणि परिपालनीयानि ॥"
  },
  {
   "ref": "79",
   "sa": "सर्वदा सर्वभावेन निश्चिन्तितैर्भगवानेव भजनीयः ॥"
  },
  {
   "ref": "80",
   "sa": "स कीर्त्यमानः शीघ्रमेवाविर्भवति अनुभावयति च भक्तान् ॥",
   "head": "प्रेमभक्तेः फलं भक्तेः सर्वश्रेष्ठता च"
  },
  {
   "ref": "81",
   "sa": "त्रिसत्यस्य भक्तिरेव गरीयसी भक्तिरेव गरीयसी ॥"
  },
  {
   "ref": "82",
   "sa": "गुणमाहात्म्यासक्ति-रूपासक्ति-पूजासक्ति-स्मरणासक्ति-दास्यासक्ति-सख्यासक्ति-कान्तासक्ति-वात्सल्यासक्ति-आत्मनिवेदनासक्ति-तन्मयतासक्ति-परमविरहासक्तिरूपा एकधाप्येकादशधा भवति ॥"
  },
  {
   "ref": "83",
   "sa": "इत्येवं वदन्ति जनजल्पनिर्भया एकमताः कुमार-व्यास-शुक-शाण्डिल्य-गर्ग-विष्णु-कौण्डिन्य-शेष-उद्धव-आरुणि-बलि-हनुमद्-विभीषणादयो भक्त्याचार्याः ॥"
  },
  {
   "ref": "84",
   "sa": "य इदं नारदप्रोक्तं शिवानुशासनं विश्वसिति श्रद्धत्ते, स भक्तिमान् भवति, स प्रेष्ठं लभत इति ॥"
  }
 ]
}

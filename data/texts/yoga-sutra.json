{
 "id": "yoga-sutra",
 "title": "Pātañjala Yoga Sūtra",
 "title_sa": "पातञ्जलयोगसूत्रम्",
 "subject": "yoga",
 "unit": 4,
 "topics": [
  "Yoga Sutra: structure and key sutras"
 ],
 "about": "Patañjali; 195 sūtras in four pādas: Samādhi (51), Sādhana (55), Vibhūti (55), Kaivalya (34).",
 "divisions": [
  "pāda",
  "sūtra"
 ],
 "sources": [
  "gretil-etexts"
 ],
 "lines": [
  {
   "ref": "1.1",
   "sa": "अथ योगानुशासनम् ॥"
  },
  {
   "ref": "1.2",
   "sa": "योगश्चित्तवृत्तिनिरोधः ॥"
  },
  {
   "ref": "1.3",
   "sa": "तदा द्रष्टुः स्वरूपेऽवस्थानम् ॥"
  },
  {
   "ref": "1.4",
   "sa": "वृत्तिसारूप्यमितरत्र ॥"
  },
  {
   "ref": "1.5",
   "sa": "वृत्तयः पञ्चतय्यः क्लिष्टाक्लिष्टाः ॥"
  },
  {
   "ref": "1.6",
   "sa": "प्रमाणविपर्ययविकल्पनिद्रास्मृतयः ॥"
  },
  {
   "ref": "1.7",
   "sa": "प्रत्यक्षानुमानागमाः प्रमाणानि ॥"
  },
  {
   "ref": "1.8",
   "sa": "विपर्ययो मिथ्याज्ञानमतद्रूपप्रतिष्ठम् ॥"
  },
  {
   "ref": "1.9",
   "sa": "शब्दज्ञानानुपाती वस्तुशून्यो विकल्पः ॥"
  },
  {
   "ref": "1.10",
   "sa": "अभावप्रत्ययालम्बना वृत्तिर्निद्रा ॥"
  },
  {
   "ref": "1.11",
   "sa": "अनुभूतविषयासंप्रमोषः स्मृतिः ॥"
  },
  {
   "ref": "1.12",
   "sa": "अभ्यासवैराग्याभ्यां तन्निरोधः ॥"
  },
  {
   "ref": "1.13",
   "sa": "तत्र स्थितौ यत्नोऽभ्यासः ॥"
  },
  {
   "ref": "1.14",
   "sa": "स तु दीर्घकालनैरन्तर्यसत्कारासेवितो दृढभूमिः ॥"
  },
  {
   "ref": "1.15",
   "sa": "दृष्टानुश्रविकविषयवितृष्णस्य वशीकारसंज्ञा वैराग्यम् ॥"
  },
  {
   "ref": "1.16",
   "sa": "तत्परं पुरुषख्यातेर्गुणवैतृष्ण्यम् ॥"
  },
  {
   "ref": "1.17",
   "sa": "वितर्कविचारानन्दास्मितारूपानुगमात्संप्रज्ञातः ॥"
  },
  {
   "ref": "1.18",
   "sa": "विरामप्रत्ययाभ्यासपूर्वः संस्कारशेषोऽन्यः ॥"
  },
  {
   "ref": "1.19",
   "sa": "भवप्रत्ययो विदेहप्रकृतिलयानाम् ॥"
  },
  {
   "ref": "1.20",
   "sa": "श्रद्धावीर्यस्मृतिसमाधिप्रज्ञापूर्वक इतरेषाम् ॥"
  },
  {
   "ref": "1.21",
   "sa": "तीव्रसंवेगानामासन्नः ॥"
  },
  {
   "ref": "1.22",
   "sa": "मृदुमध्याधिमात्रत्वात्ततोऽपि विशेषः ॥"
  },
  {
   "ref": "1.23",
   "sa": "ईश्वरप्रणिधानाद्वा ॥"
  },
  {
   "ref": "1.24",
   "sa": "क्लेशकर्मविपाकाशयैरपरामृष्टः पुरुषविशेष ईश्वरः ॥"
  },
  {
   "ref": "1.25",
   "sa": "तत्र निरतिशयं सर्वज्ञबीजम् ॥"
  },
  {
   "ref": "1.26",
   "sa": "पूर्वेषामपि गुरुः कालेनानवच्छेदात् ॥"
  },
  {
   "ref": "1.27",
   "sa": "तस्य वाचकः प्रणवः ॥"
  },
  {
   "ref": "1.28",
   "sa": "तज्जपस्तदर्थभावनम् ॥"
  },
  {
   "ref": "1.29",
   "sa": "ततः प्रत्यक्चेतनाधिगमोऽप्यन्तरायाभावश्च ॥"
  },
  {
   "ref": "1.30",
   "sa": "व्याधिस्त्यानसंशयप्रमादालस्याविरतिभ्रान्तिदर्शनालब्धभूमिकत्वानवस्थितत्वानि चित्तविक्षेपास्तेऽन्तरायाः ॥"
  },
  {
   "ref": "1.31",
   "sa": "दुःखदौर्मनस्याङ्गमेजयत्वश्वासप्रश्वासा विक्षेपसहभुवः ॥"
  },
  {
   "ref": "1.32",
   "sa": "तत्प्रतिषेधार्थमेकतत्त्वाभ्यासः ॥"
  },
  {
   "ref": "1.33",
   "sa": "मैत्रीकरुणामुदितोपेक्षाणां सुखदुःखपुण्यापुण्यविषयाणां भावनातश्चित्तप्रसादनम् ॥"
  },
  {
   "ref": "1.34",
   "sa": "प्रच्छर्दनविधारणाभ्यां वा प्राणस्य ॥"
  },
  {
   "ref": "1.35",
   "sa": "विषयवती वा प्रवृत्तिरुत्पन्ना मनसः स्थितिनिबन्धनी ॥"
  },
  {
   "ref": "1.36",
   "sa": "विशोका वा ज्योतिष्मती ॥"
  },
  {
   "ref": "1.37",
   "sa": "वीतरागविषयं वा चित्तम् ॥"
  },
  {
   "ref": "1.38",
   "sa": "स्वप्ननिद्राज्ञानालम्बनं वा ॥"
  },
  {
   "ref": "1.39",
   "sa": "यथाभिमतध्यानाद्वा ॥"
  },
  {
   "ref": "1.40",
   "sa": "परमाणुपरममहत्त्वान्तोऽस्य वशीकारः ॥"
  },
  {
   "ref": "1.41",
   "sa": "क्षीणवृत्तेरभिजातस्येव मणेर्ग्रहीतृग्रहणग्राह्येषु तत्स्थतदञ्जनता समापत्तिः ॥"
  },
  {
   "ref": "1.42",
   "sa": "तत्र शब्दार्थज्ञानविकल्पैः संकीर्णा सवितर्का समापत्तिः ॥"
  },
  {
   "ref": "1.43",
   "sa": "स्मृतिपरिशुद्धौ स्वरूपशून्येवार्थमात्रनिर्भासा निर्वितर्का ॥"
  },
  {
   "ref": "1.44",
   "sa": "एतयैव सविचारा निर्विचारा च सूक्ष्मविषया व्याख्याता ॥"
  },
  {
   "ref": "1.45",
   "sa": "सूक्ष्मविषयत्वं चालिङ्गपर्यवसानम् ॥"
  },
  {
   "ref": "1.46",
   "sa": "ता एव सबीजः समाधिः ॥"
  },
  {
   "ref": "1.47",
   "sa": "निर्विचारवैशारद्येऽध्यात्मप्रसादः ॥"
  },
  {
   "ref": "1.48",
   "sa": "ऋतंभरा तत्र प्रज्ञा ॥"
  },
  {
   "ref": "1.49",
   "sa": "श्रुतानुमानप्रज्ञाभ्यामन्यविषया विशेषार्थत्वात् ॥"
  },
  {
   "ref": "1.50",
   "sa": "तज्जः संस्कारोऽन्यसंस्कारप्रतिबन्धी ॥"
  },
  {
   "ref": "1.51",
   "sa": "तस्यापि निरोधे सर्वनिरोधान्निर्बीजः समाधिः ॥"
  },
  {
   "ref": "2.1",
   "sa": "तपःस्वाध्यायेश्वरप्रणिधानानि क्रियायोगः ॥"
  },
  {
   "ref": "2.2",
   "sa": "समाधिभावनार्थः क्लेशतनूकरणार्थश्च ॥"
  },
  {
   "ref": "2.3",
   "sa": "अविद्यास्मितारागद्वेषाभिनिवेशाः क्लेशाः ॥"
  },
  {
   "ref": "2.4",
   "sa": "अविद्या क्षेत्रमुत्तरेषां प्रसुप्ततनुविच्छिन्नोदाराणाम् ॥"
  },
  {
   "ref": "2.5",
   "sa": "अनित्याशुचिदुःखानात्मसु नित्यशुचिसुखात्मख्यातिरविद्या ॥"
  },
  {
   "ref": "2.6",
   "sa": "दृग्दर्शनशक्त्योरेकात्मतेवास्मिता ॥"
  },
  {
   "ref": "2.7",
   "sa": "सुखानुशयी रागः ॥"
  },
  {
   "ref": "2.8",
   "sa": "दुःखानुशयी द्वेषः ॥"
  },
  {
   "ref": "2.9",
   "sa": "स्वरसवाही विदुषोऽपि तथा रूढोऽभिनिवेशः ॥"
  },
  {
   "ref": "2.10",
   "sa": "ते प्रतिप्रसवहेयाः सूक्ष्माः ॥"
  },
  {
   "ref": "2.11",
   "sa": "ध्यानहेयास्तद्वृत्तयः ॥"
  },
  {
   "ref": "2.12",
   "sa": "क्लेशमूलः कर्माशयो दृष्टादृष्टजन्मवेदनीयः ॥"
  },
  {
   "ref": "2.13",
   "sa": "सति मूले तद्विपाको जात्यायुर्भोगाः ॥"
  },
  {
   "ref": "2.14",
   "sa": "ते ह्लादपरितापफलाः पुण्यापुण्यहेतुत्वात् ॥"
  },
  {
   "ref": "2.15",
   "sa": "परिणामतापसंस्कारदुःखैर्गुणवृत्तिविरोधाच्च दुःखमेव सर्वं विवेकिनः ॥"
  },
  {
   "ref": "2.16",
   "sa": "हेयं दुःखमनागतम् ॥"
  },
  {
   "ref": "2.17",
   "sa": "द्रष्टृदृश्ययोः संयोगो हेयहेतुः ॥"
  },
  {
   "ref": "2.18",
   "sa": "प्रकाशक्रियास्थितिशीलं भूतेन्द्रियात्मकं भोगापवर्गार्थं दृश्यम् ॥"
  },
  {
   "ref": "2.19",
   "sa": "विशेषाविशेषलिङ्गमात्रालिङ्गानि गुणपर्वाणि ॥"
  },
  {
   "ref": "2.20",
   "sa": "द्रष्टा दृशिमात्रः शुद्धोऽपि प्रत्ययानुपश्यः ॥"
  },
  {
   "ref": "2.21",
   "sa": "तदर्थ एव दृश्यस्यात्मा ॥"
  },
  {
   "ref": "2.22",
   "sa": "कृतार्थं प्रति नष्टमप्यनष्टं तदन्यसाधारणत्वात् ॥"
  },
  {
   "ref": "2.23",
   "sa": "स्वस्वामिशक्त्योः स्वरूपोपलब्धिहेतुः संयोगः ॥"
  },
  {
   "ref": "2.24",
   "sa": "तस्य हेतुरविद्या ॥"
  },
  {
   "ref": "2.25",
   "sa": "तदभावात्संयोगाभावो हानं तद्दृशेः कैवल्यम् ॥"
  },
  {
   "ref": "2.26",
   "sa": "विवेकख्यातिरविप्लवा हानोपायः ॥"
  },
  {
   "ref": "2.27",
   "sa": "तस्य सप्तधा प्रान्तभूमिः प्रज्ञा ॥"
  },
  {
   "ref": "2.28",
   "sa": "योगाङ्गानुष्ठानादशुद्धिक्षये ज्ञानदीप्तिरा विवेकख्यातेः ॥"
  },
  {
   "ref": "2.29",
   "sa": "यमनियमासनप्राणायामप्रत्याहारधारणाध्यानसमाधयोऽष्टावङ्गानि ॥"
  },
  {
   "ref": "2.30",
   "sa": "अहिंसासत्यास्तेयब्रह्मचर्यापरिग्रहा यमाः ॥"
  },
  {
   "ref": "2.31",
   "sa": "जातिदेशकालसमयानवच्छिन्नाः सार्वभौमा महाव्रतम् ॥"
  },
  {
   "ref": "2.32",
   "sa": "शौचसंतोषतपःस्वाध्यायेश्वरप्रणिधानानि नियमाः ॥"
  },
  {
   "ref": "2.33",
   "sa": "वितर्कबाधने प्रतिपक्षभावनम् ॥"
  },
  {
   "ref": "2.34",
   "sa": "वितर्का हिंसादयः कृतकारितानुमोदिता लोभक्रोधमोहपूर्वका मृदुमध्याधिमात्रा दुःखाज्ञानानन्तफला इति प्रतिपक्षभावनम् ॥"
  },
  {
   "ref": "2.35",
   "sa": "अहिंसाप्रतिष्ठायां तत्संनिधौ वैरत्यागः ॥"
  },
  {
   "ref": "2.36",
   "sa": "सत्यप्रतिष्ठायां क्रियाफलाश्रयत्वम् ॥"
  },
  {
   "ref": "2.37",
   "sa": "अस्तेयप्रतिष्ठायां सर्वरत्नोपस्थानम् ॥"
  },
  {
   "ref": "2.38",
   "sa": "ब्रह्मचर्यप्रतिष्ठायां वीर्यलाभः ॥"
  },
  {
   "ref": "2.39",
   "sa": "अपरिग्रहस्थैर्ये जन्मकथंतासंबोधः ॥"
  },
  {
   "ref": "2.40",
   "sa": "शौचात्स्वाङ्गजुगुप्सा परैरसंसर्गः ॥"
  },
  {
   "ref": "2.41",
   "sa": "सत्त्वशुद्धिसौमनस्यैकाग्र्येन्द्रियजयात्मदर्शनयोग्यत्वानि च ॥"
  },
  {
   "ref": "2.42",
   "sa": "संतोषादनुत्तमः सुखलाभः ॥"
  },
  {
   "ref": "2.43",
   "sa": "कायेन्द्रियसिद्धिरशुद्धिक्षयात्तपसः ॥"
  },
  {
   "ref": "2.44",
   "sa": "स्वाध्यायादिष्टदेवतासंप्रयोगः ॥"
  },
  {
   "ref": "2.45",
   "sa": "समाधिसिद्धिरीश्वरप्रणिधानात् ॥"
  },
  {
   "ref": "2.46",
   "sa": "स्थिरसुखमासनम् ॥"
  },
  {
   "ref": "2.47",
   "sa": "प्रयत्नशैथिल्यानन्तसमापत्तिभ्याम् ॥"
  },
  {
   "ref": "2.48",
   "sa": "ततो द्वन्द्वानभिघातः ॥"
  },
  {
   "ref": "2.49",
   "sa": "तस्मिन्सति श्वासप्रश्वासयोर्गतिविच्छेदः प्राणायामः ॥"
  },
  {
   "ref": "2.50",
   "sa": "बाह्याभ्यन्तरस्तम्भवृत्तिर्देशकालसंख्याभिः परिदृष्टो दीर्घसूक्ष्मः ॥"
  },
  {
   "ref": "2.51",
   "sa": "बाह्याभ्यन्तरविषयाक्षेपी चतुर्थः ॥"
  },
  {
   "ref": "2.52",
   "sa": "ततः क्षीयते प्रकाशावरणम् ॥"
  },
  {
   "ref": "2.53",
   "sa": "धारणासु च योग्यता मनसः ॥"
  },
  {
   "ref": "2.54",
   "sa": "स्वविषयासंप्रयोगे चित्तस्वरूपानुकार इवेन्द्रियाणां प्रत्याहारः ॥"
  },
  {
   "ref": "2.55",
   "sa": "ततः परमा वश्यतेन्द्रियाणाम् ॥"
  },
  {
   "ref": "3.1",
   "sa": "देशबन्धश्चित्तस्य धारणा ॥"
  },
  {
   "ref": "3.2",
   "sa": "तत्र प्रत्ययैकतानता ध्यानम् ॥"
  },
  {
   "ref": "3.3",
   "sa": "तदेवार्थमात्रनिर्भासं स्वरूपशून्यमिव समाधिः ॥"
  },
  {
   "ref": "3.4",
   "sa": "त्रयमेकत्र संयमः ॥"
  },
  {
   "ref": "3.5",
   "sa": "तज्जयात्प्रज्ञालोकः ॥"
  },
  {
   "ref": "3.6",
   "sa": "तस्य भूमिषु विनियोगः ॥"
  },
  {
   "ref": "3.7",
   "sa": "त्रयमन्तरङ्गं पूर्वेभ्यः ॥"
  },
  {
   "ref": "3.8",
   "sa": "तदपि बहिरङ्गं निर्बीजस्य ॥"
  },
  {
   "ref": "3.9",
   "sa": "व्युत्थाननिरोधसंस्कारयोरभिभवप्रादुर्भावौ निरोधक्षणचित्तान्वयो निरोधपरिणामः ॥"
  },
  {
   "ref": "3.10",
   "sa": "तस्य प्रशान्तवाहिता संस्कारात् ॥"
  },
  {
   "ref": "3.11",
   "sa": "सर्वार्थतैकाग्रतयोः क्षयोदयौ चित्तस्य समाधिपरिणामः ॥"
  },
  {
   "ref": "3.12",
   "sa": "ततः पुनः शान्तोदितौ तुल्यप्रत्ययौ चित्तस्यैकाग्रतापरिणामः ॥"
  },
  {
   "ref": "3.13",
   "sa": "एतेन भूतेन्द्रियेषु धर्मलक्षणावस्थापरिणामा व्याख्याताः ॥"
  },
  {
   "ref": "3.14",
   "sa": "शान्तोदिताव्यपदेश्यधर्मानुपाती धर्मी ॥"
  },
  {
   "ref": "3.15",
   "sa": "क्रमान्यत्वं परिणामान्यत्वे हेतुः ॥"
  },
  {
   "ref": "3.16",
   "sa": "परिणामत्रयसंयमादतीतानागतज्ञानम् ॥"
  },
  {
   "ref": "3.17",
   "sa": "शब्दार्थप्रत्ययानामितरेतराध्यासात्संकरस्तत्प्रविभागसंयमात्सर्वभूतरुतज्ञानम् ॥"
  },
  {
   "ref": "3.18",
   "sa": "संस्कारसाक्षात्करणात्पूर्वजातिज्ञानम् ॥"
  },
  {
   "ref": "3.19",
   "sa": "प्रत्ययस्य परचित्तज्ञानम् ॥"
  },
  {
   "ref": "3.20",
   "sa": "न च तत्सालम्बनं तस्याविषयीभूतत्वात् ॥"
  },
  {
   "ref": "3.21",
   "sa": "कायरूपसंयमात्तद्ग्राह्यशक्तिस्तम्भे चक्षुःप्रकाशासंप्रयोगेऽन्तर्धानम् ॥"
  },
  {
   "ref": "3.22",
   "sa": "सोपक्रमं निरुपक्रमं च कर्म तत्संयमादपरान्तज्ञानमरिष्टेभ्यो वा ॥"
  },
  {
   "ref": "3.23",
   "sa": "मैत्र्यादिषु बलानि ॥"
  },
  {
   "ref": "3.24",
   "sa": "बलेषु हस्तिबलादीनि ॥"
  },
  {
   "ref": "3.25",
   "sa": "प्रवृत्त्यालोकन्यासात्सूक्ष्मव्यवहितविप्रकृष्टज्ञानम् ॥"
  },
  {
   "ref": "3.26",
   "sa": "भुवनज्ञानं सूर्ये संयमात् ॥"
  },
  {
   "ref": "3.27",
   "sa": "चन्द्रे ताराव्यूहज्ञानम् ॥"
  },
  {
   "ref": "3.28",
   "sa": "ध्रुवे तद्गतिज्ञानम् ॥"
  },
  {
   "ref": "3.29",
   "sa": "नाभिचक्रे कायव्यूहज्ञानम् ॥"
  },
  {
   "ref": "3.30",
   "sa": "कण्ठकूपे क्षुत्पिपासानिवृत्तिः ॥"
  },
  {
   "ref": "3.31",
   "sa": "कूर्मनाड्यां स्थैर्यम् ॥"
  },
  {
   "ref": "3.32",
   "sa": "मूर्धज्योतिषि सिद्धदर्शनम् ॥"
  },
  {
   "ref": "3.33",
   "sa": "प्रातिभाद्वा सर्वम् ॥"
  },
  {
   "ref": "3.34",
   "sa": "हृदये चित्तसंवित् ॥"
  },
  {
   "ref": "3.35",
   "sa": "सत्त्वपुरुषयोरत्यन्तासंकीर्णयोः प्रत्ययाविशेषो भोगः परार्थात्स्वार्थसंयमात्पुरुषज्ञानम् ॥"
  },
  {
   "ref": "3.36",
   "sa": "ततः प्रातिभश्रावणवेदनादर्शास्वादवार्ता जायन्ते ॥"
  },
  {
   "ref": "3.37",
   "sa": "ते समाधावुपसर्गा व्युत्थाने सिद्धयः ॥"
  },
  {
   "ref": "3.38",
   "sa": "बन्धकारणशैथिल्यात्प्रचारसंवेदनाच्च चित्तस्य परशरीरावेशः ॥"
  },
  {
   "ref": "3.39",
   "sa": "उदानजयाज्जलपङ्ककण्टकादिष्वसङ्ग उत्क्रान्तिश्च ॥"
  },
  {
   "ref": "3.40",
   "sa": "समानजयाज्ज्वलनम् ॥"
  },
  {
   "ref": "3.41",
   "sa": "श्रोत्राकाशयोः संबन्धसंयमाद्दिव्यं श्रोत्रम् ॥"
  },
  {
   "ref": "3.42",
   "sa": "कायाकाशयोः संबन्धसंयमाल्लघुतूलसमापत्तेश्चाकाशगमनम् ॥"
  },
  {
   "ref": "3.43",
   "sa": "बहिरकल्पिता वृत्तिर्महाविदेहा ततः प्रकाशावरणक्षयः ॥"
  },
  {
   "ref": "3.44",
   "sa": "स्थूलस्वरूपसूक्ष्मान्वयार्थवत्त्वसंयमाद्भूतजयः ॥"
  },
  {
   "ref": "3.45",
   "sa": "ततोऽणिमादिप्रादुर्भावः कायसंपत्तद्धर्मानभिघातश्च ॥"
  },
  {
   "ref": "3.46",
   "sa": "रूपलावण्यबलवज्रसंहननत्वानि कायसंपत् ॥"
  },
  {
   "ref": "3.47",
   "sa": "ग्रहणस्वरूपास्मितान्वयार्थवत्त्वसंयमादिन्द्रियजयः ॥"
  },
  {
   "ref": "3.48",
   "sa": "ततो मनोजवित्वं विकरणभावः प्रधानजयश्च ॥"
  },
  {
   "ref": "3.49",
   "sa": "सत्त्वपुरुषान्यताख्यातिमात्रस्य सर्वभावाधिष्ठातृत्वं सर्वज्ञातृत्वं च ॥"
  },
  {
   "ref": "3.50",
   "sa": "तद्वैराग्यादपि दोषबीजक्षये कैवल्यम् ॥"
  },
  {
   "ref": "3.51",
   "sa": "स्थान्युपनिमन्त्रणे सङ्गस्मयाकरणं पुनरनिष्टप्रसङ्गात् ॥"
  },
  {
   "ref": "3.52",
   "sa": "क्षणतत्क्रमयोः संयमाद्विवेकजं ज्ञानम् ॥"
  },
  {
   "ref": "3.53",
   "sa": "जातिलक्षणदेशैरन्यतानवच्छेदात्तुल्ययोस्ततः प्रतिपत्तिः ॥"
  },
  {
   "ref": "3.54",
   "sa": "तारकं सर्वविषयं सर्वथाविषयमक्रमं चेति विवेकजं ज्ञानम् ॥"
  },
  {
   "ref": "3.55",
   "sa": "सत्त्वपुरुषयोः शुद्धिसाम्ये कैवल्यमिति ॥"
  },
  {
   "ref": "4.1",
   "sa": "जन्मौषधिमन्त्रतपःसमाधिजाः सिद्धयः ॥"
  },
  {
   "ref": "4.2",
   "sa": "जात्यन्तरपरिणामः प्रकृत्यापूरात् ॥"
  },
  {
   "ref": "4.3",
   "sa": "निमित्तमप्रयोजकं प्रकृतीनां वरणभेदस्तु ततः क्षेत्रिकवत् ॥"
  },
  {
   "ref": "4.4",
   "sa": "निर्माणचित्तान्यस्मितामात्रात् ॥"
  },
  {
   "ref": "4.5",
   "sa": "प्रवृत्तिभेदे प्रयोजकं चित्तमेकमनेकेषाम् ॥"
  },
  {
   "ref": "4.6",
   "sa": "तत्र ध्यानजमनाशयम् ॥"
  },
  {
   "ref": "4.7",
   "sa": "कर्माशुक्लाकृष्णं योगिनस्त्रिविधमितरेषाम् ॥"
  },
  {
   "ref": "4.8",
   "sa": "ततस्तद्विपाकानुगुणानामेवाभिव्यक्तिर्वासनानाम् ॥"
  },
  {
   "ref": "4.9",
   "sa": "जातिदेशकालव्यवहितानामप्यानन्तर्यं स्मृतिसंस्कारयोरेकरूपत्वात् ॥"
  },
  {
   "ref": "4.10",
   "sa": "तासामनादित्वं चाशिषो नित्यत्वात् ॥"
  },
  {
   "ref": "4.11",
   "sa": "हेतुफलाश्रयालम्बनैः संगृहीतत्वादेषामभावे तदभावः ॥"
  },
  {
   "ref": "4.12",
   "sa": "अतीतानागतं स्वरूपतोऽस्त्यध्वभेदाद्धर्माणाम् ॥"
  },
  {
   "ref": "4.13",
   "sa": "ते व्यक्तसूक्ष्मा गुणात्मानः ॥"
  },
  {
   "ref": "4.14",
   "sa": "परिणामैकत्वाद्वस्तुतत्त्वम् ॥"
  },
  {
   "ref": "4.15",
   "sa": "वस्तुसाम्ये चित्तभेदात्तयोर्विभक्तः पन्थाः ॥"
  },
  {
   "ref": "4.16",
   "sa": "न चैकचित्ततन्त्रं वस्तु तदप्रमाणकं तदा किं स्यात् ॥"
  },
  {
   "ref": "4.17",
   "sa": "तदुपरागापेक्षित्वाच्चित्तस्य वस्तु ज्ञाताज्ञातम् ॥"
  },
  {
   "ref": "4.18",
   "sa": "सदा ज्ञाताश्चित्तवृत्तयस्तत्प्रभोः पुरुषस्यापरिणामित्वात् ॥"
  },
  {
   "ref": "4.19",
   "sa": "न तत्स्वाभासं दृश्यत्वात् ॥"
  },
  {
   "ref": "4.20",
   "sa": "एकसमये चोभयानवधारणम् ॥"
  },
  {
   "ref": "4.21",
   "sa": "चित्तान्तरदृश्ये बुद्धिबुद्धेरतिप्रसङ्गः स्मृतिसंकरश्च ॥"
  },
  {
   "ref": "4.22",
   "sa": "चितेरप्रतिसंक्रमायास्तदाकारापत्तौ स्वबुद्धिसंवेदनम् ॥"
  },
  {
   "ref": "4.23",
   "sa": "द्रष्टृदृश्योपरक्तं चित्तं सर्वार्थम् ॥"
  },
  {
   "ref": "4.24",
   "sa": "तदसंख्येयवासनाभिश्चित्रमपि परार्थं संहत्यकारित्वात् ॥"
  },
  {
   "ref": "4.25",
   "sa": "विशेषदर्शिन आत्मभावभावनानिवृत्तिः ॥"
  },
  {
   "ref": "4.26",
   "sa": "तदा विवेकनिम्नं कैवल्यप्राग्भारं चित्तम् ॥"
  },
  {
   "ref": "4.27",
   "sa": "तच्छिद्रेषु प्रत्ययान्तराणि संस्कारेभ्यः ॥"
  },
  {
   "ref": "4.28",
   "sa": "हानमेषां क्लेशवदुक्तम् ॥"
  },
  {
   "ref": "4.29",
   "sa": "प्रसंख्यानेऽप्यकुसीदस्य सर्वथा विवेकख्यातेर्धर्ममेघः समाधिः ॥"
  },
  {
   "ref": "4.30",
   "sa": "ततः क्लेशकर्मनिवृत्तिः ॥"
  },
  {
   "ref": "4.31",
   "sa": "तदा सर्वावरणमलापेतस्य ज्ञानस्यानन्त्याज्ज्ञेयमल्पम् ॥"
  },
  {
   "ref": "4.32",
   "sa": "ततः कृतार्थानां परिणामक्रमसमाप्तिर्गुणानाम् ॥"
  },
  {
   "ref": "4.33",
   "sa": "क्षणप्रतियोगी परिणामापरान्तनिर्ग्राह्यः क्रमः ॥"
  },
  {
   "ref": "4.34",
   "sa": "पुरुषार्थशून्यानां गुणानां प्रतिप्रसवः कैवल्यं स्वरूपप्रतिष्ठा वा चितिशक्तिरिति ॥"
  }
 ]
}
